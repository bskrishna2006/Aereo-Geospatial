# ==============================================================================
# Aereo Geospatial File Measurement API - Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=false
APP_NAME=Aereo Geospatial Measurement API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/geomeasure_db

# File Upload & Storage Settings
# Upload directory path located outside the application source tree
UPLOAD_DIRECTORY=/tmp/aereo_geospatial_uploads
MAX_UPLOAD_SIZE_MB=50
MAX_UNCOMPRESSED_RATIO=100

# Processing Mode
# true: Synchronous processing (POST returns COMPLETED status immediately)
# false: Asynchronous background processing (POST returns PROCESSING status)
SYNC_PROCESSING=true

# Geospatial Precision & Geometry Handling
DEFAULT_DECIMAL_PRECISION=4
ATTEMPT_GEOMETRY_REPAIR=true
